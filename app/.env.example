# ---- World ID (server-only; never expose these) ----
# Developer Portal → your app. rp_id looks like rp_..., app_id like app_...
# An older app has no rp_id until you click the "Enable World ID 4.0" banner.
WORLD_RP_ID=
WORLD_APP_ID=
# Signing key for RP signatures. Used by signRequest(). Never send to the client.
WORLD_SIGNING_KEY_HEX=
# Any long random string. Signs viewing challenges and presence receipts.
# Generate: openssl rand -hex 32
PRESENCE_CHALLENGE_SECRET=

# ---- World ID (client-visible) ----
# Both are public: app_id goes in the IDKit request, rp_id goes in rp_context.
NEXT_PUBLIC_WORLD_APP_ID=
NEXT_PUBLIC_WORLD_RP_ID=
# staging while using the Sandbox app; production for a real deployment.
NEXT_PUBLIC_WORLD_ENVIRONMENT=staging

# ---- Dev only: complete IDKit requests via the World ID Simulator ----
# Lets enrollment work in the browser with no phone. The server route is ALSO guarded
# on NODE_ENV, so this cannot switch on in a production build -- it 404s.
WORLD_DEV_SIMULATOR=1
NEXT_PUBLIC_WORLD_DEV_SIMULATOR=1

# ---- Hedera (needed before any World route can succeed) ----
# bindings.ts ships fail-closed stubs: until these exist, every route throws.
HEDERA_RPC_URL=https://testnet.hashio.io/api
REGISTRAR_PRIVATE_KEY=
IDENTITY_BINDING_ADDRESS=
RENTAL_REGISTRY_ADDRESS=

# ---- Arkiv (browser-visible read access key; restrict this key to your app origin) ----
NEXT_PUBLIC_ARKIV_ACCESS_KEY=
# Comma-separated Rabdi addresses allowed to sign property reviews.
NEXT_PUBLIC_REGISTRAR_WALLETS=0xE47DBA74b5F91f216D9456d1d6698b6907c391dF

# ---- Swarm ----
# A reachable Bee API endpoint with browser CORS enabled. The endpoint must allow
# POST /bytes and GET /bytes/{reference} from the deployed app's origin.
NEXT_PUBLIC_SWARM_BEE_URL=https://api.gateway.ethswarm.org
# Required by Bee for uploads: a funded 64-character postage batch ID.
NEXT_PUBLIC_SWARM_POSTAGE_BATCH_ID=
